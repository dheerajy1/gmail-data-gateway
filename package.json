{
  "name": "jobs-api-gateway",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "dev": "bunx tailwindcss -i ./src/tailwind.css -o ./public/global.css && bun --env-file=.env.development --hot src/server.ts",
    "build": "bun run clean && bunx tailwindcss -i ./src/tailwind.css -o ./public/global.css && tsc && tsc-alias && cp -r public dist/public",
    "start": "bun --env-file=.env.production dist/server.js",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "clean": "rm -rf dist/* dist/.* || true",
    "test:db": "bun scripts/db-select-test.ts",
    "test:ingest": "bun src/tests/run-ingest.ts",
    "token:gen": "bun src/lib/generate-token.ts",
    "token:getexpat": "bun scripts/get-token-expiry.ts",
    "dev:subscriber": "bun src/lib/azure-sync-job-subscriber.ts",
    "compile:subscriber": "mkdir -p dist && bun build ./src/lib/azure-sync-job-subscriber.ts --target=bun --compile --outfile=dist/azure-sync-job-subscriber",
    "start:subscriber:binary": "./dist/azure-sync-job-subscriber",
    "madge:subscriber": "madge --ts-config tsconfig.json --extensions ts src/lib/azure-sync-job-subscriber.ts",
    "madge:subscriber:json": "madge --ts-config tsconfig.json --extensions ts --json src/lib/azure-sync-job-subscriber.ts",
    "madge:subscriber:circular": "madge --ts-config tsconfig.json --extensions ts --circular src/lib/azure-sync-job-subscriber.ts",
    "build:subscriber": "bun build ./src/lib/azure-sync-job-subscriber.ts --target=bun --outfile=dist/azure-sync-job-subscriber.js",
    "start:subscriber": "bun dist/azure-sync-job-subscriber.js",
    "docker:build": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml build",
    "docker:build:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml build jobsdata-subscriber",
    "docker:up": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml up -d",
    "docker:up:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml up -d jobsdata-subscriber",
    "docker:stop": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml stop",
    "docker:stop:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml stop jobsdata-subscriber",
    "docker:down": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml down",
    "docker:down:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml down jobsdata-subscriber",
    "docker:restart": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml down && docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml up -d",
    "docker:restart:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml restart jobsdata-subscriber",
    "docker:logs": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml logs -f",
    "docker:logs:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml logs -f jobsdata-subscriber",
    "docker:rmi": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml down --rmi local",
    "docker:rmi:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml rm -sf jobsdata-subscriber && docker image rm -f jobsdata-subscriber:latest",
    "docker:clean": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml down --rmi local --volumes --remove-orphans",
    "docker:clean:subscriber": "docker compose -f ~/dev/vs-code/jobs-api-gateway/docker/docker-compose.yml rm -sf jobsdata-subscriber && docker image rm -f jobsdata-subscriber:latest"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/static": "^1.4.7",
    "elysia": "^1.4.22",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.564.0",
    "mssql": "^12.2.0",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/bun": "1.3.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.8",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "madge": "^8.0.0",
    "semantic-release": "^25.0.2",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "5.8.3"
  }
}
