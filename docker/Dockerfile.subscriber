# Builds ONE permanent jobs-api-gateway WebSocket subscriber binary.
# Preferred: jobs-subscriber
#
#   --build-arg SUBSCRIBER_MAIN=src/lib/jobs-subscriber/main.ts
#   --build-arg SUBSCRIBER_BINARY=jobs-subscriber

FROM oven/bun:1.2.21 AS builder

WORKDIR /app

ARG SUBSCRIBER_MAIN=src/lib/jobs-subscriber/main.ts
ARG SUBSCRIBER_BINARY=jobs-subscriber

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src

# Compile to a standalone binary (same style as record-log)
RUN mkdir -p dist && bun build ./${SUBSCRIBER_MAIN} --target=bun --compile --outfile=dist/${SUBSCRIBER_BINARY}

# ──────────────────────────────────────────────
# Runtime image
# ──────────────────────────────────────────────
FROM debian:bookworm-slim

WORKDIR /app

ARG SUBSCRIBER_BINARY=jobs-subscriber
ENV SUBSCRIBER_BINARY=${SUBSCRIBER_BINARY}

# Keep the real name for consistency
COPY --from=builder /app/dist/${SUBSCRIBER_BINARY} /app/${SUBSCRIBER_BINARY}

ENV NODE_ENV=production

CMD ["/app/jobs-subscriber"]