# Builds the jobs-api-gateway subscriber: one process, one authenticated websocket, three topics.
# The build context is the repo root, see docker/docker-compose.yml.

FROM rust:1-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY public ./public
COPY xtask ./xtask
COPY subscriber ./subscriber

RUN cargo build --release --package subscriber

FROM debian:bookworm-slim

# CA certificates let the subscriber trust the Azure SQL server certificate
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/subscriber /app/subscriber

CMD ["/app/subscriber"]
